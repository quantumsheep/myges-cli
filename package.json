{
  "name": "myges",
  "version": "5.0.0",
  "description": "Command line interface for MyGES (Réseau GES): agenda, grades, absences, courses, projects and Google Calendar sync",
  "type": "module",
  "keywords": [],
  "main": "dist/index.js",
  "bin": {
    "myges": "dist/cli.js"
  },
  "imports": {
    "#src/*": "./dist/*"
  },
  "files": [
    "dist",
    "!dist/test"
  ],
  "scripts": {
    "start": "node dist/cli.js",
    "dev": "tsc --watch",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "contributors": [
    {
      "name": "Nathanael Demacon",
      "email": "nathanael.dmc@outlook.fr"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quantumsheep/myges-cli.git"
  },
  "author": "Nathanael Demacon <nathanael.dmc@outlook.fr>",
  "license": "MIT",
  "dependencies": {
    "cli-progress": "^3.12.0",
    "commander": "^15.1.0",
    "date-fns": "^4.4.0",
    "googleapis": "^190.0.0",
    "inquirer": "^14.3.1",
    "update-notifier": "^7.3.1"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^26.6.11",
    "@types/update-notifier": "^6.0.9",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0"
  }
}
