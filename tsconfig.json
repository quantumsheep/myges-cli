{
  "compilerOptions": {
    "module": "nodenext",
    "target": "es2023",
    "strict": true,
    "types": ["node"],
    "declaration": true,
    "removeComments": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
